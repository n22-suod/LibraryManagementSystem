@model IEnumerable<LibraryManagementSystem.Models.Book>

@{
    ViewData["Title"] = "Manage Books";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary">Library Book Management (Admin Dashboard)</h2>
    <a asp-action="Create" class="btn btn-primary fw-bold">+ Add New Book</a>
</div>

<table class="table table-striped table-hover border shadow-sm">
    <thead class="table-primary">
        <tr>
           <th>Book Cover</th>
           <th>Title</th>
            <th>Author</th>
            <th>Total Copies</th>
            <th>Available Copies</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
            <td>
    @if (!string.IsNullOrEmpty(item.CoverImagePath))
    {
        <img src="@item.CoverImagePath"
             alt="Book Cover"
             width="60"
             height="80"
             style="object-fit: cover;" />
    }
    else
    {
        <span>No Cover</span>
    }
</td>
                <td>@item.Title</td>
                <td>@item.Author</td>
                <td>@item.TotalCopies</td>
                <td>@item.AvailableCopies</td>
                <td>
                    @if (item.IsAvailable)
                    {
                        <span class="badge bg-success">Available</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Stock</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@model LibraryManagementSystem.Models.Book

@{
    ViewData["Title"] = "Add Book";
}

<h2 class="text-primary mb-4">Add New Book to Library</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="mb-3">
                <label class="form-label fw-bold">Book Title</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Author Name</label>
                <input asp-for="Author" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Total Copies</label>
                <input asp-for="TotalCopies" class="form-control"
                       type="number" min="1" required />
            </div>

            <button type="submit" class="btn btn-primary">Save Book</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>